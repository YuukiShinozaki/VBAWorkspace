{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "New: Excelプロジェクト新規作成",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.tools\\New-Project.ps1",
                "-ProjectName",
                {
                    "value": "${input:excelProjectName}",
                    "quoting": "strong"
                }
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Excel: UserForm情報をCSV出力（アドイン）",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-STA",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.tools\\UserFormCsvExporter\\Export-UserFormCsv.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Excel: 編集したUserForm CSVをExcelへ反映",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-STA",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.tools\\UserFormCsvExporter\\Import-UserFormCsv.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "excelProjectName",
            "type": "promptString",
            "description": "プロジェクト名（Project 接頭辞は自動付与。例: Sample）"
        }
    ]
}